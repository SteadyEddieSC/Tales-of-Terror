          {
            "event_key": "drowned_harbor_preview_presented",
            "classification": "diagnostic",
            "exactly_once": false,
            "idempotent_reprojection": true,
            "includes_source_revision": true,
            "includes_result_revision": true,
            "raw_identity_prohibited": true
          }
        ],
        "public_payload_private_data_prohibited": true,
        "projection_after_authoritative_commit": true
      },
      "privacy_contract": {
        "public_shared_content": [
          "Tale premise",
          "Seat range",
          "Accessibility availability",
          "Design-only status"
        ],
        "private_content": [],
        "neutral_shield_required": false,
        "authorized_private_actor_required": false,
        "private_clearing_rule": "No private content is loaded or retained by the preview interaction.",
        "public_transcript_private_content_prohibited": true,
        "public_audio_private_content_prohibited": true,
        "mirrored_private_content_prohibited": true
      },
      "recovery_contract": [
        {
          "failure": "stale_action",
          "authoritative_mutation": "none",
          "focus_destination": "tale_preview_root",
          "player_message": "The preview changed. Current review actions are shown.",
          "private_data_exposure": false,
          "stable_seat_reset": false
        },
        {
          "failure": "voice_or_caption_interrupted",
          "authoritative_mutation": "none",
          "focus_destination": "tale_preview_root",
          "player_message": "Preview details remain available in persistent text and replay.",
          "private_data_exposure": false,
          "stable_seat_reset": false
