        {
          "rule_id": "drowned_harbor_preview_available",
          "description": "The design-only Drowned Harbor preview is available through an authorized preproduction review path."
        },
        {
          "rule_id": "production_start_unavailable",
          "description": "No production Play or Start action is exposed for the design-only Tale."
        }
      ],
      "lifecycle_steps": [
        "eligible",
        "presented",
        "focused",
        "previewed",
        "settled"
      ],
      "input_intents": [
        "navigate_focus",
        "inspect_public_state",
        "open_accessibility",
        "cancel_or_back"
      ],
      "action_guards": [
        {
          "rule_id": "selected_action_current",
          "description": "The selected preview action remains present in the current legal-action projection."
        },
        {
          "rule_id": "no_runtime_entry_action",
          "description": "The selected action does not enter gameplay, create a session, or register the Tale for production."
        }
      ],
      "commit_contract": {
        "authoritative_commit": false,
        "deterministic": true,
        "confirmation_revision_required": false,
        "partial_commit_prohibited": true,
        "once_only_transition": false,
        "retry_behavior": "requery_and_present_current_state"
      },
      "projection_contract": {
        "public_outputs": [
          "Design-only Tale identity",
          "Intended seat range and public premise",
          "Presentation profile and accessibility availability",
          "Working-name legal status"
