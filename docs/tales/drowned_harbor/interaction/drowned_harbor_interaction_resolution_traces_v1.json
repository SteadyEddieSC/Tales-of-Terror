        "replay_adapter",
        "diagnostic_recorder"
      ],
      "source_paths": [
        "docs/tales/drowned_harbor/Drowned_Harbor_Design_Bible.md",
        "docs/tales/drowned_harbor/ui/drowned_harbor_core_storyboards_v1.json",
