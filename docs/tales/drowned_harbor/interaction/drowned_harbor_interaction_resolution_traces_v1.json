{
  "manifest_kind": "interaction_state_traces_preproduction",
  "schema_version": 1,
  "tale_id": "drowned_harbor",
  "production_status": "design_only",
  "record_schema": "docs/preproduction/interaction_state_trace_schema_v1.json",
  "entries": [
    {
      "trace_id": "DH-IS-007",
      "title": "Controlled-Private Harbor Bargain Terms Interaction",
      "tale_id": "drowned_harbor",
      "storyboard_id": "DH-UI-007",
      "criticality": "critical",
      "privacy_surface": "controlled_private_surface",
      "read_domains": [
        "session_public",
        "seat_public",
        "seat_private",
        "tale_private",
        "accessibility_public"
      ],
      "write_domains": [
        "seat_private",
        "tale_private",
        "tale_public",
        "session_public"
      ],
      "allowed_actors": [
        "active_stable_seat",
        "approved_takeover_controller",
        "returning_reserved_controller",
        "system"
      ],
      "entry_preconditions": [
        {
          "rule_id": "private_bargain_terms_authorized",
          "description": "The active stable seat has requested an authorized private bargain review and private terms exist for that seat."
        },
        {
          "rule_id": "neutral_shared_shield_active",
          "description": "The shared display is covered by a neutral shield before private terms are projected."
        }
      ],
      "lifecycle_steps": [
        "eligible",
        "presented",
        "focused",
        "previewed",
        "confirming",
        "committed",
        "projected",
        "settled"
      ],
      "input_intents": [
        "navigate_focus",
        "inspect_private_state",
        "confirm_action",
        "cancel_or_back",
        "acknowledge_private_state"
      ],
      "action_guards": [
        {
          "rule_id": "private_actor_authorized",
          "description": "The acknowledging controller remains authorized for the same stable seat and private handoff."
        },
        {
          "rule_id": "private_term_revision_current",
          "description": "The private bargain term and consequence revision match the preview presented to the stable seat."
        },
        {
          "rule_id": "shared_projection_neutral",
          "description": "No private term, cost, objective, faction, inventory, or inferred choice appears on the shared display."
        }
      ],
      "commit_contract": {
        "authoritative_commit": true,
        "deterministic": true,
        "confirmation_revision_required": true,
        "partial_commit_prohibited": true,
        "once_only_transition": true,
        "retry_behavior": "reproject_existing_result"
      },
      "projection_contract": {
        "public_outputs": [
          "Neutral private-handoff status",
          "Public acknowledgement that the bargain resolved",
          "Public consequence only when authorized"
        ],
        "private_outputs": [
          "Exact private bargain term",
          "Exact private cost and consequence",
          "Private accept or refuse action",
          "Private committed result"
        ],
        "emitted_events": [
          {
            "event_key": "harbor_bargain_private_term_committed",
            "classification": "private",
            "exactly_once": true,
            "idempotent_reprojection": true,
            "includes_source_revision": true,
            "includes_result_revision": true,
            "raw_identity_prohibited": true
          },
          {
            "event_key": "harbor_bargain_public_resolution_projected",
            "classification": "public",
            "exactly_once": true,
            "idempotent_reprojection": true,
            "includes_source_revision": true,
            "includes_result_revision": true,
            "raw_identity_prohibited": true
          }
        ],
        "public_payload_private_data_prohibited": true,
        "projection_after_authoritative_commit": true
      },
      "privacy_contract": {
        "public_shared_content": [
          "Stable seat receiving a private handoff where publicly authorized",
          "Neutral waiting state",
          "Publicly authorized resolution only"
        ],
        "private_content": [
          "Bargain term",
          "Bargain cost",
          "Private consequence",
          "Private response"
        ],
        "neutral_shield_required": true,
        "authorized_private_actor_required": true,
        "private_clearing_rule": "Clear all private bargain content after acknowledgement and before the shared board is restored.",
        "public_transcript_private_content_prohibited": true,
        "public_audio_private_content_prohibited": true,
        "mirrored_private_content_prohibited": true
      },
      "recovery_contract": [
        {
          "failure": "private_surface_unavailable",
          "authoritative_mutation": "none",
          "focus_destination": "private_handoff_unavailable",
          "player_message": "Private terms cannot be shown safely. No bargain was committed.",
          "private_data_exposure": false,
          "stable_seat_reset": false
        },
        {
          "failure": "companion_unavailable",
          "authoritative_mutation": "none",
          "focus_destination": "local_private_handoff_option",
          "player_message": "The Companion is unavailable. Use the authorized local private handoff or refuse the bargain.",
          "private_data_exposure": false,
          "stable_seat_reset": false
        },
        {
          "failure": "authority_changed",
          "authoritative_mutation": "none",
          "focus_destination": "neutral_shared_shield",
          "player_message": "Control authority changed. Private content was cleared and must be reopened by the authorized seat.",
          "private_data_exposure": false,
          "stable_seat_reset": false
        },
        {
          "failure": "confirmation_expired",
          "authoritative_mutation": "none",
          "focus_destination": "private_bargain_terms",
          "player_message": "Confirmation expired. Review the current private term before committing.",
          "private_data_exposure": false,
          "stable_seat_reset": false
        }
      ],
      "presentation_obligations": {
        "required_layout_regions": [
          "private_shield_full_screen",
          "decision_panel_center",
          "controller_prompt_strip"
        ],
        "focus_owner_visible": true,
        "focus_restoration_rule": "Return private focus only to the authorized stable seat; otherwise clear content and retain the neutral shield.",
        "confirmation_pattern": "safe_handoff_confirmation",
        "persistent_text_required": true,
        "plain_system_required": true,
        "caption_support_required": true,
        "transcript_private_exclusion_required": true,
        "active_seat_identity_preserved": true,
        "control_source_visibility": "public_when_applicable",
        "no_audio_operation_required": true
      },
      "implementation_seams": [
        "authoritative_state_reader",
        "legal_action_query",
        "command_validator",
        "deterministic_reducer",
        "public_projection_builder",
        "private_projection_builder",
        "focus_coordinator",
        "controller_authority_adapter",
        "caption_transcript_adapter",
        "diagnostic_recorder"
      ],
      "source_paths": [
        "docs/design/Seat_Continuity_and_Admission.md",
        "docs/tales/drowned_harbor/ui/drowned_harbor_core_storyboards_v1.json",
        "docs/preproduction/drowned_harbor_cross_media_traceability_v1.json"
      ],
      "traceability_concepts": [
        "DH-XM-008"
      ],
      "human_validation_questions": [
        "Can a living-room group verify that the shared display reveals no private bargain terms?",
        "Can the authorized seat review and clear private terms without accidental commitment or controller confusion?"
      ],
      "status": "preproduction_ready",
      "approval_boundary": "Traceability record only; no private display implementation, Companion dependency, bargain term, reducer, event payload, or production mechanic is approved."
    },
    {
